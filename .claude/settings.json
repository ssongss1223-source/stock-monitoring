{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
"mcp__vm-ssh__ssh_run",
      "mcp__vm-ssh__service_status",
      "mcp__vm-ssh__service_restart",
      "mcp__vm-ssh__tail_log",
      "mcp__telegram__send_message",
      "Bash(python -m pytest tests/test_account.py -v)",
      "Bash(python -m pytest tests/test_account.py tests/test_sma_signal.py -v --tb=short)",
      "Bash(python scripts/run_sma_backtest_v2.py --dry-run)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/auto_checkpoint.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "understand-anything@understand-anything": true,
    "watch@claude-video": true,
    "agentmemory@agentmemory": true,
    "andrej-karpathy-skills@karpathy-skills": false
  },
  "plansDirectory": ".claude/plans"
}
